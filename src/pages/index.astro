---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const apps = (await getCollection("apps"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm David <span class="text-xl">👋🏻</span>
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I’m a product minded engineering leader passionate about creating an
            impact on people’s health.
          </p>
          <p class="animate">
            I’m inspired by extreme programming, lean software development, and
            management 3.0.
          </p>
          <p class="animate">
            Occasionally I make free apps that do one thing well. No accounts,
            no tracking, nothing to learn before you start.
          </p>
        </article>
      </section>

      <section id="apps" class="animate space-y-6 scroll-mt-24">
        <h5 class="font-semibold text-black dark:text-white">
          Apps
        </h5>
        <ul class="flex flex-col gap-4">
          {apps.map(app => {
            const [texts] = Object.values(app.data.languages);
            return (
              <li>
                <ArrowCard
                  href={`/${app.id}/`}
                  title={app.data.name}
                  description={texts.tagline}
                  icon={`/apps/${app.id}/icon.png`}
                />
              </li>
            );
          })}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            Want to talk about something, or just say hi? Email me.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>

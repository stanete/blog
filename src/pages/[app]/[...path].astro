---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

// Every app has a landing page, a Privacy Policy and Terms of Service, each in
// its languages: `/koala/`, `/koala/privacy/`, `/koala/es/`, `/koala/es/privacy/`.
export async function getStaticPaths() {
  const apps = await getCollection("apps");
  const legal = await getCollection("legal");
  return apps.flatMap((app) => {
    const [first] = Object.keys(app.data.languages);
    return Object.keys(app.data.languages).flatMap((lang) => {
      const folder = lang === first ? "" : `${lang}/`;
      const pages = legal.filter((page) => page.slug.startsWith(`${app.id}/${lang}/`));
      return [
        { params: { app: app.id, path: folder.slice(0, -1) || undefined }, props: { app, lang } },
        ...pages.map((page) => ({
          params: { app: app.id, path: folder + page.slug.split("/")[2] },
          props: { app, lang, page },
        })),
      ];
    });
  });
}

type Props = {
  app: CollectionEntry<"apps">;
  lang: string;
  page?: CollectionEntry<"legal">;
};

const { app, lang, page } = Astro.props;
const { name, screenshots, testflight, languages } = app.data;
const texts = languages[lang];
const [first] = Object.keys(languages);

const home = (code: string) => `/${app.id}/${code === first ? "" : `${code}/`}`;
const here = home(lang);
const assets = `/apps/${app.id}`;
const mail = `mailto:${SITE.EMAIL}?subject=${encodeURIComponent(texts.android.subject)}&body=${encodeURIComponent(texts.android.body)}`;
const Content = page && (await page.render()).Content;

// What search engines and AI assistants read about the app: the page in each
// language, and the app and its questions as schema.org data.
const url = (path: string) => new URL(path, Astro.site).href;
const alternates = Object.keys(languages).map((code) => ({ code, href: url(home(code)) }));
const shotAlt = (index: number) =>
  texts.shots?.[index] ??
  texts.screenshot.replace("{n}", String(index + 1)).replace("{total}", String(screenshots));
const shotSrc = (index: number) => `${assets}/screenshots/${lang}/${String(index + 1).padStart(2, "0")}.jpg`;
const structured = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name,
    alternateName: `${name}: ${texts.tagline}`,
    description: texts.description ?? texts.pitch,
    url: url(here),
    image: url(`${assets}/icon.png`),
    screenshot: Array.from({ length: screenshots }, (_, index) => url(shotSrc(index))),
    applicationCategory: "SportsApplication",
    operatingSystem: "iOS, Android",
    inLanguage: Object.keys(languages),
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    datePublished: app.data.date.toISOString().slice(0, 10),
    author: { "@type": "Person", name: SITE.NAME, url: url("/"), email: SITE.EMAIL },
  },
  ...(texts.faq?.length
    ? [{
      "@context": "https://schema.org",
      "@type": "FAQPage",
      inLanguage: lang,
      mainEntity: texts.faq.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    }]
    : []),
];

const button = "inline-block rounded-full px-5 py-3 text-sm font-semibold transition-colors duration-300 ease-in-out";
const loud = "bg-black text-white hover:bg-black/75 dark:bg-white dark:text-black dark:hover:bg-white/75";
const quiet = "bg-stone-100 text-black hover:bg-stone-200 dark:bg-white/10 dark:text-white dark:hover:bg-white/15";
---

<PageLayout
  title={page ? `${page.data.title} · ${name}` : `${name}: ${texts.tagline}`}
  description={page ? page.data.title : texts.description ?? texts.pitch}
  lang={lang}
  image={`${assets}/share.jpg`}
>
  <link slot="head" rel="apple-touch-icon" href={`${assets}/apple-touch-icon.png`} />
  {!page && alternates.map(({ code, href }) => (
    <link slot="head" rel="alternate" hreflang={code} href={href} />
  ))}
  {!page && <link slot="head" rel="alternate" hreflang="x-default" href={url(home(first))} />}
  {!page && <script slot="head" type="application/ld+json" set:html={JSON.stringify(structured)} />}
  <link slot="head" rel="alternate" type="text/plain" title={`${name} for AI assistants`} href={`/${app.id}/llms.txt`} />

  {page && Content ? (
    <Container>
      <a href={here} class="animate inline-block -ml-1.5" aria-label={name}>
        <img src={`${assets}/icon.png`} alt="" width="48" height="48" />
      </a>
      <div class="space-y-1 my-10">
        <div class="animate text-sm">{page.data.updated}</div>
        <h1 class="animate text-2xl font-semibold text-black dark:text-white">{page.data.title}</h1>
      </div>
      <article class="animate">
        <Content />
      </article>
    </Container>
  ) : (
    <Fragment>
    <Container>
      {/* A title and a few lines, as on a post: the pictures below do the selling. */}
      {/* The koala breathes, sleeps from 22:00 to 7:00 by the visitor's clock, and jumps
          when clicked, as in the app. Decoration only, so screen readers skip it. */}
      <div class="animate -ml-3">
        <div class="koala" aria-hidden="true">
          <div class="koala-jump">
            <div class="koala-droop">
              <div class="koala-breath">
                <img src={`${assets}/icon.png`} alt="" width="96" height="96" />
                <span class="lid lid-left"></span>
                <span class="lid lid-right"></span>
              </div>
            </div>
            <span class="z text-stone-400">z</span>
            <span class="z text-stone-400">z</span>
            <span class="z text-stone-400">z</span>
          </div>
        </div>
      </div>
      <script is:inline>
        (() => {
          const koala = document.querySelector(".koala");
          if (!koala) return;
          const sleepy = () => {
            const hour = new Date().getHours();
            koala.classList.toggle("asleep", hour >= 22 || hour < 7);
          };
          sleepy();
          setInterval(sleepy, 60000);
          // Nobody jumps in their sleep: it wakes for the jump, then nods off again.
          const jump = koala.querySelector(".koala-jump");
          koala.addEventListener("click", () => {
            if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            koala.classList.remove("jumping");
            void jump.offsetWidth;
            koala.classList.add("jumping");
          });
          jump.addEventListener("animationend", (event) => {
            if (event.target === jump) koala.classList.remove("jumping");
          });
        })();
      </script>
      <h1 class="animate mt-6 mb-4 text-2xl font-semibold text-black dark:text-white text-balance">
        {name}: {texts.tagline}
      </h1>
      <article class="animate">
        <p>{texts.pitch}</p>
        <p>{texts.free}</p>
      </article>
    </Container>

    <div class="animate gallery">
      {Array.from({ length: screenshots }, (_, index) => (
        <img
          src={shotSrc(index)}
          alt={shotAlt(index)}
          width="660"
          height="1434"
          loading="lazy"
        />
      ))}
    </div>

    <Container>
      <div class="space-y-4">
        {/* How to get the beta, in a card like the app's own: a small label, the
            message, a few words more, then what to tap. The phone picks its side,
            and the reader can switch. */}
        <section class="animate beta rounded-[1.625rem] bg-white dark:bg-stone-800 p-5">
          {testflight && <input type="radio" name="phone" id="beta-iphone" class="sr-only" checked />}
          {testflight && <input type="radio" name="phone" id="beta-android" class="sr-only" />}
          <div class="phones flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
            <h2>{texts.beta}</h2>
            {testflight && (
              <div class="flex gap-1">
                <label for="beta-iphone">iPhone</label>
                <span>/</span>
                <label for="beta-android">Android</label>
              </div>
            )}
          </div>
          {testflight && (
            <div class="iphone">
              <p class="mt-1 font-semibold text-black dark:text-white">{texts.iphone.title}</p>
              <p class="mt-1 text-sm">{texts.iphone.text}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                <a class:list={[button, loud]} href={testflight}>{texts.iphone.join}</a>
                <a class:list={[button, quiet]} href="https://apps.apple.com/app/testflight/id899247664">
                  {texts.iphone.getTestFlight}
                </a>
              </div>
            </div>
          )}
          <div class="android">
            <p class="mt-1 font-semibold text-black dark:text-white">{texts.android.title}</p>
            <p class="mt-1 text-sm">{texts.android.text}</p>
            <div class="mt-4">
              <a class:list={[button, loud]} href={mail}>{texts.android.send}</a>
            </div>
          </div>
        </section>
        {/* Plain questions and answers, in the words people search with. */}
        {texts.faq && texts.faq.length > 0 && (
          <section class="animate faq pt-12">
            <h2 class="text-sm">{texts.faqTitle}</h2>
            {texts.faq.map(({ q, a }) => (
              <div class="mt-6">
                <h3 class="font-semibold text-black dark:text-white">{q}</h3>
                <p class="mt-1">{a}</p>
              </div>
            ))}
          </section>
        )}
        <script is:inline>
          if (/android/i.test(navigator.userAgent)) document.getElementById("beta-android")?.click();
        </script>
      </div>
    </Container>
    </Fragment>
  )}

  <Container>
    <nav class="animate mt-16 space-y-2 text-sm">
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        <Link href={`${here}privacy/`}>{texts.privacy}</Link>
        <Link href={`${here}terms/`}>{texts.terms}</Link>
        <Link href={`mailto:${SITE.EMAIL}`}>{texts.contact}</Link>
      </div>
      <div class="flex flex-wrap gap-1">
        {Object.entries(languages).map(([code, other], index) => (
          <>
            {index > 0 && <span>/</span>}
            {code === lang ? (
              <span class="text-black dark:text-white" aria-current="true">{other.language}</span>
            ) : (
              <Link href={home(code)} lang={code}>{other.language}</Link>
            )}
          </>
        ))}
      </div>
    </nav>
  </Container>
</PageLayout>

<style>
  /* The switch between the two phones: two hidden radio buttons, no script. */
  /* They read like the site's other links: the phone shown is plain, the other one is underlined. */
  .phones label {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(0, 0, 0, 0.15);
  }
  :global(.dark) .phones label {
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }
  #beta-iphone:checked ~ .phones label[for="beta-iphone"],
  #beta-android:checked ~ .phones label[for="beta-android"] {
    color: black;
    text-decoration: none;
    cursor: default;
  }
  :global(.dark) #beta-iphone:checked ~ .phones label[for="beta-iphone"],
  :global(.dark) #beta-android:checked ~ .phones label[for="beta-android"] {
    color: white;
  }
  .beta input:focus-visible ~ .phones label {
    outline: 1px dotted currentColor;
    outline-offset: 2px;
  }
  #beta-iphone:checked ~ .android,
  #beta-android:checked ~ .iphone {
    display: none;
  }
  /* The koala, as in the app. Its eyelids are placed in % of the picture. */
  .koala {
    position: relative;
    width: 96px;
    height: 96px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .koala img {
    display: block;
  }
  .koala-jump,
  .koala-droop,
  .koala-breath {
    transform-origin: 50% 80%;
  }
  .koala-breath {
    position: relative;
    animation: breathe 4s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      transform: translateY(-2px) scale(1.035);
    }
  }
  .koala-droop {
    transition: transform 0.3s ease-in-out;
  }
  .koala.asleep:not(.jumping) .koala-droop {
    transform: translateY(2px) rotate(8deg);
    transition-duration: 1.2s;
  }
  .koala.asleep:not(.jumping) .koala-breath {
    animation: breathe-asleep 5s ease-in-out infinite;
  }
  @keyframes breathe-asleep {
    50% {
      transform: scale(1.025);
    }
  }
  .lid {
    position: absolute;
    border-radius: 50%;
    overflow: hidden;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.15s ease-in-out;
  }
  .koala.asleep:not(.jumping) .lid {
    transform: scaleY(1);
    transition-duration: 0.7s;
  }
  .lid-left {
    left: 44.5%;
    top: 51%;
    width: 10%;
    height: 12.5%;
    background: #c4c5c7;
  }
  .lid-right {
    left: 76%;
    top: 54.5%;
    width: 4.4%;
    height: 10%;
    background: #d3d4d6;
  }
  /* The line of a closed eye, curved like a smile. */
  .lid::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 22%;
    height: 45%;
    border-bottom: 1.5px solid #2c2c2e;
    border-radius: 0 0 999px 999px;
  }
  .z {
    position: absolute;
    left: 86%;
    top: 12%;
    font-family: ui-rounded, system-ui, sans-serif;
    font-weight: 900;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
  }
  .z:nth-of-type(1) {
    font-size: 19px;
  }
  .z:nth-of-type(2) {
    font-size: 24px;
  }
  .z:nth-of-type(3) {
    font-size: 29px;
  }
  .koala.asleep:not(.jumping) .z {
    animation: z 3.6s ease-out 1.2s infinite;
  }
  .koala.asleep:not(.jumping) .z:nth-of-type(2) {
    animation-delay: 2.4s;
  }
  .koala.asleep:not(.jumping) .z:nth-of-type(3) {
    animation-delay: 3.6s;
  }
  @keyframes z {
    0% {
      opacity: 0;
      transform: none;
    }
    15% {
      opacity: 1;
    }
    70% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translate(24px, -38px);
    }
  }
  .koala.jumping .koala-jump {
    animation: jump 0.6s;
  }
  @keyframes jump {
    18% {
      transform: scale(1.1, 0.88);
    }
    48% {
      transform: translateY(-18px) scale(0.95, 1.06);
    }
    74% {
      transform: scale(1.07, 0.93);
    }
    88% {
      transform: scale(0.98, 1.02);
    }
  }
  /* With reduced motion it is still: asleep, it only has its eyes closed. */
  @media (prefers-reduced-motion: reduce) {
    .koala *,
    .koala *::after {
      animation: none !important;
      transition: none !important;
    }
    .koala.asleep:not(.jumping) .koala-droop {
      transform: none;
    }
  }
  /* The store screenshots, in a row that scrolls sideways past the column.
     The room above and below is for their shadows. */
  .gallery {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 2.5rem max(1.25rem, calc((100vw - 40rem) / 2 + 1.25rem)) 3.5rem;
  }
  .gallery::-webkit-scrollbar {
    display: none;
  }
  .gallery img {
    flex: none;
    width: 15rem;
    height: auto;
    border-radius: 1.5rem;
    scroll-snap-align: center;
    box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.14);
  }
</style>
